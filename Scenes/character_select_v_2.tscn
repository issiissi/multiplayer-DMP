[sub_resource type="CSharpScript" id="CSharpScript_nhyj4"]
script/source = "using Godot;
using System;
using System.Collections.Generic;

public partial class CharacterSelectV2 : Control
{
	// Data
	private List<Texture2D> characters = new List<Texture2D>();
	private Dictionary<int, int> characterChoises = new Dictionary<int, int>();
	private Dictionary<int, bool> readyStates = new Dictionary<int, bool>();
	int myID;
	private int myCharacterIndex = 0;

	// Eigene UI
	private Label myName;
	private TextureRect myCharacterPreview;
	private Button leftButton;
	private Button rightButton;
	private Button readyButton;

	// Seiten UI
	private VBoxContainer sidePlayerList;
	[Export] private PackedScene sidePlayerTemplate;

    public override async void _Ready()
    {
		await ToSignal(GetTree().CreateTimer(0.2f), \"timeout\");

		myID = (int)Multiplayer.GetUniqueId();

        Get_Character_Textures();
		Get_UI_Nodes();

		Lobby.Instance.PlayerConnected += OnPlayerConnected;
		Lobby.Instance.OnCharacterChoiseChanged += OnCharacterChoiseChanged;
		Lobby.Instance.CharacterReadyChanged += OnCharacterReadyChanged;
		Lobby.Instance.AllCharactersReady += OnAllCharactersReady;

		GD.Print(\"[CS] Ready called\");
		GD.Print($\"[CS] Players in lobby at ready: {Lobby.Instance._players.Count}\");
    }

	private void Get_Character_Textures()
    {
        characters.Add(ResourceLoader.Load<Texture2D>(\"Assets//CharacterPreview//player_cyberpunk.png\"));
		characters.Add(ResourceLoader.Load<Texture2D>(\"Assets//CharacterPreview//player_knight.png\"));
		characters.Add(ResourceLoader.Load<Texture2D>(\"Assets//CharacterPreview//player_cat.png\"));
    }
	private void Get_UI_Nodes()
    {
		myName = GetNode<Label>(\"Name\");
		myCharacterPreview = GetNode<TextureRect>(\"Character_Preview\");
		leftButton = GetNode<Button>(\"Links\");
        rightButton = GetNode<Button>(\"Rechts\");
		readyButton = GetNode<Button>(\"Ready\");

		sidePlayerList = GetNode<VBoxContainer>(\"Other_Players\");

		leftButton.ButtonDown += Left_Button_Down;
		rightButton.ButtonDown += Right_Button_Down;
		readyButton.ButtonDown += Ready_Button_Down;
    }
	
	private void UI_Local_Player()
    {
        myName.Text = Lobby.Instance._players[myID][\"Name\"];
		myCharacterPreview.Texture = characters[myCharacterIndex];
		characterChoises[myID] = myCharacterIndex;
		readyStates[myID] = false;
		GD.Print($\"[CS] UI_Local_Player for {myID}\");
    }

	private void Side_Player_List()
    {
        foreach (Node c in sidePlayerList.GetChildren())
			c.QueueFree();
		
		foreach (var entry in Lobby.Instance._players)
        {
            int id = (int)entry.Key;
			if (id == myID) continue;

			var ui = sidePlayerTemplate.Instantiate<Control>();
			ui.GetNode<Label>(\"Name\").Text = entry.Value[\"Name\"];

			int index = Lobby.Instance.GetChoiseFor(id);
			ui.GetNode<TextureRect>(\"Character_Preview\").Texture = characters[index];

			sidePlayerList.AddChild(ui);
        }
    }

	// Input
	private void Left_Button_Down()
    {
        myCharacterIndex = (myCharacterIndex - 1 + characters.Count) % characters.Count;
		myCharacterPreview.Texture = characters[myCharacterIndex];

		Lobby.Instance.Rpc(Lobby.MethodName.CS_SetChoice, myCharacterIndex);
    }
	private void Right_Button_Down()
    {
        myCharacterIndex = (myCharacterIndex + 1) % characters.Count;
		myCharacterPreview.Texture = characters[myCharacterIndex];

		Lobby.Instance.Rpc(Lobby.MethodName.CS_SetChoice, myCharacterIndex);
    }
	private void Ready_Button_Down()
    {
        readyStates[myID] = !readyStates[myID];
		readyButton.Text = readyStates[myID] ? \"Unready\" : \"Ready\";

		Lobby.Instance.Rpc(Lobby.MethodName.CS_SetReady, readyStates[myID]);
    }

	private void OnCharacterChoiseChanged(int playerID, int index)
    {
        if (playerID == myID) return;

		Side_Player_List();
    }

	private void OnCharacterReadyChanged(int playerID, bool isReady)
	{
		if (playerID == myID) return;

		Side_Player_List();
	}

	private void OnAllCharactersReady(bool allReady)
    {
        if (myID == 1)
			readyButton.Disabled = !allReady;
    }

	private void OnPlayerConnected(int playerID, Godot.Collections.Dictionary<string, string> playerInfo)
	{
		if (playerID != myID) return;

		GD.Print($\"[CS] OnPlayerConnected fired for {playerID}, myID={myID}\");

		UI_Local_Player();
		Side_Player_List();
	}
}
"

